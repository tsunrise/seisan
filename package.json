{
  "name": "seisan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prebuild.mjs && vite",
    "build": "node scripts/prebuild.mjs && tsc -b && vite build && node scripts/remove-dev-vars-artifact.mjs",
    "typecheck": "pnpm run typecheck:frontend && pnpm run typecheck:worker && pnpm run typecheck:test && pnpm run typecheck:node",
    "typecheck:frontend": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:client": "node --import tsx --test scripts/client.node-test.ts",
    "api": "tsx scripts/client-cli.ts",
    "categories:populate": "tsx scripts/populate-categories.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/standard-validator": "^0.2.2",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@scalar/api-reference-react": "^0.9.54",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@types/json-schema": "^7.0.15",
    "hono": "^4.12.22",
    "hono-openapi": "^1.3.0",
    "jose": "^6.2.3",
    "openapi-types": "^12.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "wrangler": "^4.92.0"
  }
}

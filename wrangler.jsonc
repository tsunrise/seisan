/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seisan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-25",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_LOGIN_EMAILS": "seisan-test-alice@tom.mozmail.com,seisan-test-bob@tom.mozmail.com,seisan-test-carol@tom.mozmail.com",
    "LOGIN_EMAIL_FROM": "no-reply@dev.seisan.waga.me",
    "LOCAL_DEV_LOGIN_EMAILS": "seisan-test-alice@tom.mozmail.com,seisan-test-bob@tom.mozmail.com,seisan-test-carol@tom.mozmail.com",
    "LOCAL_DEV_LOGIN_CODE": "123456",
  },
  "secrets": {
    "required": ["AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
  },
  "kv_namespaces": [
    {
      "binding": "REVOKED_TOKENS",
      "id": "66d9e9077c76445da3615c8f81130d62",
      "preview_id": "b69eac2649404af0b4264c87899cbb70",
    },
    {
      "binding": "PROJECT_REGISTRY_CACHE",
      "id": "5fbf9df51a4d49b88d3a2aecff2e2ba8",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOGIN_ATTEMPT_STORE",
        "class_name": "LoginAttemptStore",
      },
      {
        "name": "PROJECTS_REGISTRY",
        "class_name": "ProjectsRegistry",
      },
      {
        "name": "PROJECT_STORE",
        "class_name": "ProjectStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoginAttemptStore"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProjectsRegistry", "ProjectStore"],
    },
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],
  "env": {
    "test": {
      "vars": {
        "ALLOWED_LOGIN_EMAILS": "yehvd9bbu@mozmail.com",
        "LOGIN_EMAIL_FROM": "login@example.com",
        "LOCAL_DEV_LOGIN_EMAILS": "",
        "LOCAL_DEV_LOGIN_CODE": "",
      },
      "secrets": {
        "required": ["AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
      },
      "kv_namespaces": [
        {
          "binding": "REVOKED_TOKENS",
        },
        {
          "binding": "PROJECT_REGISTRY_CACHE",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LOGIN_ATTEMPT_STORE",
            "class_name": "LoginAttemptStore",
          },
          {
            "name": "PROJECTS_REGISTRY",
            "class_name": "ProjectsRegistry",
          },
          {
            "name": "PROJECT_STORE",
            "class_name": "ProjectStore",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["LoginAttemptStore"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["ProjectsRegistry", "ProjectStore"],
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
    },
    "dev": {
      "preview_urls": false,
      "workers_dev": false,
      "routes": [{ "pattern": "dev.seisan.waga.me", "custom_domain": true }],
      "vars": {
        "ALLOWED_LOGIN_EMAILS": "seisan-test-alice@tom.mozmail.com,seisan-test-bob@tom.mozmail.com,seisan-test-carol@tom.mozmail.com",
        "LOGIN_EMAIL_FROM": "no-reply@dev.seisan.waga.me",
        "LOCAL_DEV_LOGIN_EMAILS": "",
        "LOCAL_DEV_LOGIN_CODE": "",
      },
      "secrets": {
        "required": ["AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
      },
      "kv_namespaces": [
        {
          "binding": "REVOKED_TOKENS",
          "id": "66d9e9077c76445da3615c8f81130d62",
          "preview_id": "b69eac2649404af0b4264c87899cbb70",
        },
        {
          "binding": "PROJECT_REGISTRY_CACHE",
          "id": "5fbf9df51a4d49b88d3a2aecff2e2ba8",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LOGIN_ATTEMPT_STORE",
            "class_name": "LoginAttemptStore",
          },
          {
            "name": "PROJECTS_REGISTRY",
            "class_name": "ProjectsRegistry",
          },
          {
            "name": "PROJECT_STORE",
            "class_name": "ProjectStore",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["LoginAttemptStore"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["ProjectsRegistry", "ProjectStore"],
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
          "remote": true,
        },
      ],
    },
    "production": {
      "vars": {
        "ALLOWED_LOGIN_EMAILS": "yehvd9bbu@mozmail.com",
        "LOGIN_EMAIL_FROM": "no-reply@seisan.waga.me",
        "LOCAL_DEV_LOGIN_EMAILS": "",
        "LOCAL_DEV_LOGIN_CODE": "",
      },
      "routes": [{ "pattern": "seisan.waga.me", "custom_domain": true }],
      "secrets": {
        "required": ["AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
      },
      "kv_namespaces": [
        {
          "binding": "REVOKED_TOKENS",
          "id": "e0a15436bd8244e2910bf4ccdda8ddb7",
          "preview_id": "b69eac2649404af0b4264c87899cbb70",
        },
        {
          "binding": "PROJECT_REGISTRY_CACHE",
          "id": "0b22fc0923f441fc8518c18fe9bf0659",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LOGIN_ATTEMPT_STORE",
            "class_name": "LoginAttemptStore",
          },
          {
            "name": "PROJECTS_REGISTRY",
            "class_name": "ProjectsRegistry",
          },
          {
            "name": "PROJECT_STORE",
            "class_name": "ProjectStore",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["LoginAttemptStore"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["ProjectsRegistry", "ProjectStore"],
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
          "remote": true,
        },
      ],
    },
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}

/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seisan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-25",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": false,
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vectorize": [
    {
      "binding": "CATEGORY_INDEX",
      "index_name": "seisan-category-dev",
      "remote": true,
    },
  ],
  "vars": {
    "LOGIN_EMAIL_FROM": "no-reply@dev.seisan.waga.me",
    "LOCAL_DEV_LOGIN_CODE": "123456",
    "ADMIN_ACCESS_AUD": "",
    "ADMIN_ACCESS_TEAM_DOMAIN": "",
  },
  "secrets": {
    "required": ["AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
  },
  "kv_namespaces": [
    {
      "binding": "REVOKED_TOKENS",
      "id": "66d9e9077c76445da3615c8f81130d62",
      "preview_id": "b69eac2649404af0b4264c87899cbb70",
    },
    {
      "binding": "PROJECT_REGISTRY_CACHE",
      "id": "5fbf9df51a4d49b88d3a2aecff2e2ba8",
    },
    {
      "binding": "CONFIGS",
      "id": "69f9ead42e6a4f589d9d3c3d823a3dcb",
    },
    {
      "binding": "API_KEY_VERIFICATION",
      "id": "f7f75969976d45d1b5438cb974fd8ed0",
    },
    {
      "binding": "PUBLISHED_GLOBAL_CONFIG",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOGIN_ATTEMPT_STORE",
        "class_name": "LoginAttemptStore",
      },
      {
        "name": "GLOBAL_CONFIG",
        "class_name": "GlobalConfig",
      },
      {
        "name": "PROJECTS_REGISTRY",
        "class_name": "ProjectsRegistry",
      },
      {
        "name": "PROJECT_STORE",
        "class_name": "ProjectStore",
      },
      {
        "name": "LIMITS_STORE",
        "class_name": "LimitsStore",
      },
      {
        "name": "USER_API_KEYS_STORE",
        "class_name": "UserAPIKeysStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoginAttemptStore"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProjectsRegistry", "ProjectStore"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["LimitsStore"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["UserAPIKeysStore"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["CategoryPocStore"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["GlobalConfig"],
      "deleted_classes": ["CategoryPocStore"],
    },
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],
  "ratelimits": [
    {
      "name": "APPEND_RECORD_ACCOUNT_RATE_LIMITER",
      "namespace_id": "2026061801",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "APPEND_RECORD_PROJECT_RATE_LIMITER",
      "namespace_id": "2026061802",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "CATEGORY_CLASSIFICATION_ACCOUNT_RATE_LIMITER",
      "namespace_id": "2026061803",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "env": {
    "test": {
      "vars": {
        "LOGIN_EMAIL_FROM": "login@example.com",
        "LOCAL_DEV_LOGIN_CODE": "",
        "ADMIN_ACCESS_AUD": "test-aud",
        "ADMIN_ACCESS_TEAM_DOMAIN": "https://team.test",
      },
      "secrets": {
        "required": ["AUTH_SECRET", "TURNSTILE_SECRET_KEY"],
      },
      "ai": {
        "binding": "AI",
      },
      "vectorize": [
        {
          "binding": "CATEGORY_INDEX",
          "index_name": "seisan-category-test",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "REVOKED_TOKENS",
        },
        {
          "binding": "PROJECT_REGISTRY_CACHE",
        },
        {
          "binding": "CONFIGS",

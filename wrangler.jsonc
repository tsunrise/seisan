          },
          {
            "name": "GLOBAL_CONFIG",
            "class_name": "GlobalConfig",
          },
          {
            "name": "PROJECTS_REGISTRY",
            "class_name": "ProjectsRegistry",
          },
          {
            "name": "PROJECT_STORE",
            "class_name": "ProjectStore",
          },
          {
            "name": "LIMITS_STORE",
            "class_name": "LimitsStore",
          },
          {
            "name": "USER_API_KEYS_STORE",
            "class_name": "UserAPIKeysStore",
          },
        ],
      },
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
      "ratelimits": [
        {
          "name": "APPEND_RECORD_ACCOUNT_RATE_LIMITER",
          "namespace_id": "2026061811",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
        {
          "name": "APPEND_RECORD_PROJECT_RATE_LIMITER",
          "namespace_id": "2026061812",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "CATEGORY_CLASSIFICATION_ACCOUNT_RATE_LIMITER",
          "namespace_id": "2026061813",
          "simple": {
            "limit": 30,
            "period": 60,
          },
        },
      ],
    },
    "dev": {
      "preview_urls": false,
